---
import Layout from "../layouts/Layout.astro";

const projects = [
    {
        title: "homelab-net",
        description: "Network Documentation for my Homelab network",
        tags: ["Computer Networking", "Mermaid.js", "Documentation"],
        link: "https://github.com/cthul00/homelab-net",
    },
    {
        title: "os-scripts",
        description: "My personal scripts for OS configuration & automation.",
        tags: ["Scripting", "Automation", "Security"],
        link: "https://github.com/cthul00/os-scripts",
    },
];
---

<Layout title="PORTFOLIO // HOME">
    <section class="hero" style="margin-bottom: 4rem;">
        <h1 class="terminal-header">Nathan Carr</h1>
        <p style="font-size: 1.2rem; margin-top: 1rem;">
            Backyard Engineer & Tech Warlock. <br />
            Exploring the future with tools from the past.
        </p>
    </section>

    <section id="projects">
        <h2 class="terminal-header">/Projects</h2>
        <div
            style="display: grid; grid-template-columns: 1fr; gap: 2rem; margin-top: 2rem;"
        >
            {
                projects.map((project) => (
                    <div class="retro-border">
                        <h3 style="margin-top: 0;">{project.title}</h3>
                        <p>{project.description}</p>
                        <div style="margin: 1rem 0;">
                            {project.tags.map((tag) => (
                                <span style="font-size: 0.8rem; color: var(--accent-color); margin-right: 1rem; border: 1px solid var(--accent-color); border-radius: 4px; padding: 2px 6px;">
                                    {" "}
                                    [{tag}]
                                </span>
                            ))}
                        </div>
                        <a href={project.link} style="font-weight: bold;">
                            [ ACCESS_DETAILS ]
                        </a>
                    </div>
                ))
            }
        </div>
    </section>
</Layout>
